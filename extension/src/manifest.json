{
  "manifest_version": 3,
  "name": "MeetingPlz",
  "version": "1.0.1",
  "description": "Two minutes before a meeting, a plane flies by and one big Join button shows up.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "alarms", "storage", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MeetingPlz",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
